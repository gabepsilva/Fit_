# The environment fit.service reads, installed at /etc/fit/fit.env (0600, root).
#
# The deploy writes this file only when it is absent, so an edit on the machine
# survives the next release. There are no secrets in it today; when there are,
# they are placed here by hand and never travel through this repository.

NODE_ENV=production

# adapter-node's canonical origin. It is also the origin policy's allow-list
# (src/lib/server/origin-policy.ts): every state-changing request must carry
# this Origin or be refused, so a wrong value here breaks sign-in, visibly.
ORIGIN=https://fit.psilva.org

# Cloudflare terminates TLS and forwards plain HTTP, so the unit binds 80 with
# CAP_NET_BIND_SERVICE. Behind a proxy on this machine instead, set
# HOST=127.0.0.1 and a high PORT, and drop the capability from the unit.
HOST=0.0.0.0
PORT=80

# The sign-in throttle keys on the visitor, not on the proxy
# (src/lib/server/client-address.ts). ADDRESS_HEADER is adapter-node's, and it
# lower-cases the name before looking it up. A request that arrives without
# this header fails: nothing but Cloudflare should be reaching this port.
FIT_CLIENT_ADDRESS=forwarded
ADDRESS_HEADER=cf-connecting-ip

# The application database. Its directory is 0700 and owned by the service
# user, and is the only path ProtectSystem=strict leaves writable.
FIT_DB_PATH=/var/lib/fit/app.sqlite
