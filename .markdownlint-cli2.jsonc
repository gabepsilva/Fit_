{
	"config": {
		"MD010": { "code_blocks": false },
		"MD013": false,
		"MD024": { "siblings_only": true },
		"MD033": false
	},
	"globs": [
		"**/*.md",
		"!android/**",
		"!build-capacitor/**",
		// The nutrition ETL pipeline is a Python project that happens to live in
		// this tree. Its docs are not this repository's prose.
		"!data/**",
		"!node_modules/**",
		// An interrupted mutation run leaves a sandbox behind, holding a copy of
		// every dependency's README. Linting those is not a verdict on this repo.
		"!.stryker-tmp/**",
		// And an agent worktree holds a second checkout, with its own node_modules.
		"!.claude/**",
		"!.security-cache/**",
		"!.svelte-kit/**",
		"!coverage/**",
		"!playwright-report/**",
		"!test-results/**",
		"!reports/**"
	]
}
