{
	"config": {
		"MD010": { "code_blocks": false },
		"MD013": false,
		"MD024": { "siblings_only": true },
		"MD033": false
	},
	"globs": [
		"**/*.md",
		"!node_modules/**",
		"!.security-cache/**",
		"!.svelte-kit/**",
		"!coverage/**",
		"!playwright-report/**",
		"!test-results/**",
		"!reports/**"
	]
}
